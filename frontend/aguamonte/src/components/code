<script setup>
import { ref, reactive, computed, onMounted } from "vue";
import {
  obtenerProductos,
  crearProducto,
  actualizarProducto,
  eliminarProducto,
} from "./api/servicios.js";
import { urlImagen } from "./utils/imagen.js";

const categoryOptions = [
  { value: "chalecos", label: "Chalecos" },
  { value: "camisas", label: "Camisas" },
  { value: "bolsos", label: "Bolsos" },
];
const activityOptions = [
  { value: "rafting", label: "Rafting" },
  { value: "pesca", label: "Pesca" },
  { value: "corporativo", label: "Corporativo" },
];
const customizationOptions = [
  { value: "sublimado", label: "Sublimado" },
  { value: "bordado", label: "Bordado" },
];

// Columnas para q-table
const columns = [
  { name: "name", label: "Nombre", field: "name", align: "left", sortable: true },
  { name: "category", label: "Categoría", field: "category", align: "left" },
  { name: "activity", label: "Actividad", field: "activity", align: "left" },
  { name: "customization", label: "Personalización", field: "customization", align: "left" },
  { name: "tag", label: "Etiqueta", field: "tag", align: "left" },
  { name: "acciones", label: "Acciones", field: "acciones", align: "right" },
];

const productos = ref([]);
const esEdicion = ref(false);
const editandoId = ref(null);

// Filas ya con etiquetas legibles para la tabla
const rows = computed(() =>
  productos.value.map((p) => ({
    ...p,
    category: labelDe(categoryOptions, p.category),
    activity: labelDe(activityOptions, p.activity),
    customization: labelDe(customizationOptions, p.customization),
  }))
);

const form = reactive({
  name: "",
  category: "",
  activity: "",
  customization: "",
  tag: "",
  tagClass: "text-primary",
  image: "",
  description: "",
  detail: "",
});

function labelDe(opciones, valor) {
  if (!valor) return "—";
  const o = opciones.find((x) => x.value === valor);
  return o ? o.label : valor;
}

function limpiarForm() {
  Object.assign(form, {
    name: "",
    category: "",
    activity: "",
    customization: "",
    tag: "",
    tagClass: "text-primary",
    image: "",
    description: "",
    detail: "",
  });
}

async function cargar() {
  try {
    productos.value = await obtenerProductos();
  } catch (e) {
    console.error("Error al cargar productos:", e);
  }
}

function editar(p) {
  esEdicion.value = true;
  editandoId.value = p._id || p.id;
  Object.assign(form, {
    name: p.name || "",
    category: p.category || "",
    activity: p.activity || "",
    customization: p.customization || "",
    tag: p.tag || "",
    tagClass: p.tagClass || "text-primary",
    image: p.image || "",
    description: p.description || "",
    detail: p.detail || "",
  });
}

function cancelarEdicion() {
  esEdicion.value = false;
  editandoId.value = null;
  limpiarForm();
}

async function guardar() {
  if (!form.name.trim()) return;
  try {
    if (esEdicion.value) {
      await actualizarProducto(editandoId.value, { ...form });
    } else {
      await crearProducto({ ...form });
    }
    cancelarEdicion();
    await cargar();
  } catch (e) {
    console.error("No se pudo guardar:", e);
    alert("No se pudo guardar el producto.");
  }
}

async function eliminar(p) {
  const ok = window.confirm(`¿Eliminar "${p.name}"?`);
  if (!ok) return;
  try {
    await eliminarProducto(p._id || p.id);
    await cargar();
  } catch (e) {
    console.error("No se pudo eliminar:", e);
    alert("No se pudo eliminar el producto.");
  }
}

onMounted(cargar);
</script>

